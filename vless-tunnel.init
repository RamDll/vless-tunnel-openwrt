#!/bin/sh /etc/rc.common
# /etc/init.d/vless-tunnel
#
# Тонкий procd-юнит: держит Xray и навешивает/снимает маршрутизацию.
# Вся логика установки, разбора ссылки и генерации config.json живёт
# в /usr/bin/vless-tunnel — сюда она не заползает.
#
# Режимы whitelist/proxy: TPROXY-правила в 10-vless-tunnel.nft перехватывают
# весь TCP/UDP из LAN (кроме приватных сетей и bypass) — решение "туннель
# или напрямую" принимает сам Xray через routing.rules (sniffing SNI/TLS).
# Режим dns: в TPROXY идут только адреса из сетов — vless4/vless6 (subnets,
# sets_load ниже) и vless4_dns/vless6_dns (наполняет dnsmasq по nftset=).
# Перед каждым стартом /usr/bin/vless-tunnel _build-config вставляет
# актуальные списки в config.json, после старта _dns-up отдаёт dnsmasq файл
# с server= (DNS доменов из списка — через туннель) и, для dns, nftset=.

USE_PROCD=1
START=99
STOP=10

CONF=vless-tunnel
BIN=/usr/bin/vless-tunnel
XRAY_BIN=/usr/bin/xray
CONFIG_JSON=/etc/vless-tunnel/config.json

. /lib/functions.sh

load_cfg() {
	config_load "$CONF"
	config_get enabled     main enabled     0
	config_get tproxy_port main tproxy_port 12345
	config_get fwmark      main fwmark      0x1e5
	config_get rttable     main table       100
	config_get mode        main mode        whitelist
	config_get subnets     main subnets     /etc/vless-tunnel/subnets
}

route_up() {
	# del перед add — иначе повторный старт плодит одинаковые правила
	while ip rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip rule add fwmark "$fwmark" lookup "$rttable" priority 100
	ip route replace local 0.0.0.0/0 dev lo table "$rttable"

	while ip -6 rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip -6 rule add fwmark "$fwmark" lookup "$rttable" priority 100
	ip -6 route replace local ::/0 dev lo table "$rttable"
}

route_down() {
	while ip rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip route flush table "$rttable" 2>/dev/null

	while ip -6 rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip -6 route flush table "$rttable" 2>/dev/null
}

# Режим dns: subnets -> элементы сетов. Комментарии и пустые строки
# выкидываем. Строки с ":" — IPv6 (в vless6), без ":" — IPv4 (в vless4).
# На stop сеты не чистятся: без policy routing (route_down) TPROXY по
# оставшемуся в сете IP не зависает в чёрной дыре, а идёт обычной пересылкой.
sets_load() {
	local elems4 elems6
	nft flush set inet fw4 vless4 2>/dev/null
	nft flush set inet fw4 vless6 2>/dev/null
	[ -f "$subnets" ] || return 0
	elems4=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$subnets" | grep -v '^$' | grep -v ':' | tr '\n' ',' | sed 's/,$//')
	elems6=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$subnets" | grep -v '^$' | grep ':' | tr '\n' ',' | sed 's/,$//')
	[ -n "$elems4" ] && nft add element inet fw4 vless4 "{ $elems4 }"
	[ -n "$elems6" ] && nft add element inet fw4 vless6 "{ $elems6 }"
	return 0
}

# Xray стартует не мгновенно, а TPROXY-правила без слушателя = чёрная дыра
# для ВСЕГО LAN-трафика (не только из списков — теперь перехват общий).
# Ждём порт, прежде чем включать policy routing.
wait_for_port() {
	local i=0
	while [ "$i" -lt 10 ]; do
		netstat -ln 2>/dev/null | grep -q ":$tproxy_port " && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

start_service() {
	load_cfg
	[ "$enabled" = "1" ] || { echo "vless-tunnel: выключен в /etc/config/$CONF"; return 0; }
	[ -x "$XRAY_BIN" ]   || { echo "vless-tunnel: нет $XRAY_BIN"; return 1; }

	# Пересобираем config.json из сохранённой ссылки и ТЕКУЩИХ
	# domains/subnets при каждом старте — правки в списках применяются
	# без повторного set-link.
	"$BIN" _build-config || {
		echo "vless-tunnel: нет конфига — vless-tunnel set-link \"vless://...\""; return 1; }

	# Конфиг проверяет само ядро — до того, как мы тронем сеть.
	# XRAY_LOCATION_ASSET обязателен и здесь: в mode=proxy в правилах есть
	# geoip:ru, а `xray -test` без переменной ищет geoip.dat рядом с бинарником.
	XRAY_LOCATION_ASSET=/etc/vless-tunnel "$XRAY_BIN" run -test -c "$CONFIG_JSON" >/dev/null 2>&1 || {
		echo "vless-tunnel: ядро отвергло $CONFIG_JSON"; return 1; }

	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -c "$CONFIG_JSON"
	# geoip.dat (нужен только режиму proxy) лежит рядом с config.json;
	# Xray ищет geo-данные по XRAY_LOCATION_ASSET. geosite.dat не ставим —
	# домены по-прежнему inline в routing.rules.
	procd_set_param env GOMEMLIMIT=48MiB XRAY_LOCATION_ASSET=/etc/vless-tunnel
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	load_cfg
	[ "$enabled" = "1" ] || return 0
	wait_for_port || {
		echo "vless-tunnel: ядро не слушает $tproxy_port — перехват не включаю"
		return 1
	}
	route_up
	[ "$mode" = "dns" ] && sets_load
	"$BIN" _dns-up
}

stop_service() {
	load_cfg
	"$BIN" _dns-down
	route_down
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

reload_service() {
	stop
	start
}
