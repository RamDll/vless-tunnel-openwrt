# /etc/config/vless-tunnel
#
# Всё состояние туннеля живёт здесь. Ссылка vless:// хранится как есть —
# config.json для Xray генерируется из неё и лежит в /etc/vless-tunnel/,
# то есть правится только через `vless-tunnel set-link`, руками не трогается.

config tunnel 'main'
	# Пока 0 — init-скрипт не поднимет ни ядро, ни перехват.
	# Включается после первой настройки: vless-tunnel on
	option enabled '0'

	# Ссылка на сервер. Пустая до `vless-tunnel setup`.
	option link ''

	# Интерфейс, чей трафик перехватываем. Должен совпадать
	# с iifname в /etc/nftables.d/10-vless-tunnel.nft.
	option lan 'br-lan'

	option tproxy_port '12345'

	# Метка намеренно не 0x1. Единица — самое популярное значение
	# в чужих рецептах, и её же любят mwan3 и sqm-скрипты;
	# столкнуться с ними на роутере проще, чем кажется.
	option fwmark '0x1e5'
	option table '100'

	# Списки. Формат обоих: одна запись в строке, # — комментарий.
	#   domains: youtube.com          (поддомены попадают автоматически)
	#   subnets: 203.0.113.0/24
	option domains '/etc/vless-tunnel/domains'
	option subnets '/etc/vless-tunnel/subnets'

	# block  — IPv6 клиентов режется (умолчание: без этого трафик
	#          уйдёт по v6 мимо списков и мимо туннеля)
	# direct — v6 идёт напрямую, утечки на совести владельца
	option ipv6 'block'
