# /etc/config/vless-tunnel
#
# Всё состояние туннеля живёт здесь. Ссылка vless:// хранится как есть —
# config.json для Xray генерируется из неё и лежит в /etc/vless-tunnel/,
# то есть правится только через `vless-tunnel set-link`, руками не трогается.

config tunnel 'main'
	# Пока 0 — init-скрипт не поднимет ни ядро, ни перехват.
	# Включается после первой настройки: vless-tunnel on
	option enabled '0'

	# Ссылка на сервер. Пустая до `vless-tunnel setup`.
	option link ''

	# Интерфейс, чей трафик перехватываем. Должен совпадать
	# с iifname в /etc/nftables.d/10-vless-tunnel.nft.
	option lan 'br-lan'

	option tproxy_port '12345'

	# Метка намеренно не 0x1. Единица — самое популярное значение
	# в чужих рецептах, и её же любят mwan3 и sqm-скрипты;
	# столкнуться с ними на роутере проще, чем кажется.
	option fwmark '0x1e5'
	option table '100'

	# Режим маршрутизации:
	#   whitelist — в туннель только domains/subnets (обратная совместимость);
	#   proxy     — в туннель весь веб (TCP 80/443/8443, UDP 443), кроме
	#               RU-доменов/адресов и direct-domains.
	# Переключается командой `vless-tunnel mode proxy|whitelist`.
	option mode 'whitelist'

	# Уровень логов Xray (warning по умолчанию; debug — для отладки
	# маршрутизации: в нём видно `[tproxy-in -> proxy|direct]`).
	option log_level 'warning'

	# route_only='1' — Xray соединяется с IP, который уже увидел TPROXY,
	# без своего DNS; '0' — домен из sniffing отдаётся на резолв (proxy —
	# серверу, direct — самому Xray). 0 лечит подменённые провайдером
	# DNS-ответы, но тогда у sniffed-трафика нет IP назначения и правило
	# geoip:ru не срабатывает — RU-сайты на .com (vk.com и т.п.) нужно
	# вписать в direct-domains.
	option route_only '1'

	# Списки. Формат всех: одна запись в строке, # — комментарий.
	#   domains: youtube.com          (в туннель, поддомены автоматически)
	#   subnets: 203.0.113.0/24       (в туннель по IP)
	#   direct-domains: bank.ru       (всегда напрямую, приоритетнее domains)
	option domains '/etc/vless-tunnel/domains'
	option subnets '/etc/vless-tunnel/subnets'
	option direct_domains '/etc/vless-tunnel/direct-domains'

	# GeoIP для mode=proxy (исключает RU-адреса из туннеля). Обновляется
	# командой `vless-tunnel update-geo`, в установщик не входит — файл
	# ~5 МБ и нужен только режиму proxy.
	option geoip '/etc/vless-tunnel/geoip.dat'
