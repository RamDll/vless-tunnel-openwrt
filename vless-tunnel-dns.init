#!/bin/sh /etc/rc.common
# /etc/init.d/vless-tunnel — вариант "-dns"
#
# Тонкий procd-юнит: держит Xray и навешивает/снимает маршрутизацию.
# Вся логика установки, разбора ссылки и генерации config.json живёт
# в /usr/bin/vless-tunnel — сюда она не заползает.
#
# Решение "домен из списка или нет" здесь принимает nftables ДО Xray, по
# членству резолвленного IP в сете — сеты наполняет dnsmasq (директива
# nftset=) при резолве домена из списка. Внутри Xray один outbound, никакой
# routing/sniffing. См. 10-vless-tunnel-dns.nft и HANDOFF.md, "Эволюция
# архитектуры" — почему это альтернатива основному варианту, а не замена.

USE_PROCD=1
START=99
STOP=10

CONF=vless-tunnel
BIN=/usr/bin/vless-tunnel
XRAY_BIN=/usr/bin/xray
CONFIG_JSON=/etc/vless-tunnel/config.json
DNSMASQ_DIR=/tmp/dnsmasq.d
DNSMASQ_CONF="$DNSMASQ_DIR/vless-tunnel.conf"

. /lib/functions.sh

load_cfg() {
	config_load "$CONF"
	config_get enabled     main enabled     0
	config_get tproxy_port main tproxy_port 12345
	config_get fwmark      main fwmark      0x1e5
	config_get rttable     main table       100
	config_get domains     main domains     /etc/vless-tunnel/domains
	config_get subnets     main subnets     /etc/vless-tunnel/subnets
}

route_up() {
	# del перед add — иначе повторный старт плодит одинаковые правила
	while ip rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip rule add fwmark "$fwmark" lookup "$rttable" priority 100
	ip route replace local 0.0.0.0/0 dev lo table "$rttable"

	while ip -6 rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip -6 rule add fwmark "$fwmark" lookup "$rttable" priority 100
	ip -6 route replace local ::/0 dev lo table "$rttable"
}

route_down() {
	while ip rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip route flush table "$rttable" 2>/dev/null

	while ip -6 rule del fwmark "$fwmark" lookup "$rttable" 2>/dev/null; do :; done
	ip -6 route flush table "$rttable" 2>/dev/null
}

# Список -> элементы сета. Комментарии и пустые строки выкидываем.
# Строки с ":" — IPv6 (в vless6), без ":" — IPv4 (в vless4): один общий
# файл subnets, классификация по формату записи, как и в парсере ссылок.
sets_load() {
	local elems4 elems6
	nft flush set inet fw4 vless4 2>/dev/null
	nft flush set inet fw4 vless6 2>/dev/null
	[ -f "$subnets" ] || return 0
	elems4=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$subnets" | grep -v '^$' | grep -v ':' | tr '\n' ',' | sed 's/,$//')
	elems6=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$subnets" | grep -v '^$' | grep ':' | tr '\n' ',' | sed 's/,$//')
	[ -n "$elems4" ] && nft add element inet fw4 vless4 "{ $elems4 }"
	[ -n "$elems6" ] && nft add element inet fw4 vless6 "{ $elems6 }"
	return 0
}

# На stop сеты (vless4/vless6/*_dns) НЕ чистятся — не недосмотр, а фикс,
# найденный при разработке основного варианта: без policy routing
# (route_down ниже) TPROXY-совпадение по оставшемуся в сете IP не зависает
# в чёрной дыре, а просто идёт обычной пересылкой напрямую. Значит чистить
# сеты для безопасного off не нужно, а нужно только для route_down — и это
# ещё чинит баг с клиентским DNS-кэшем, переживающим off/on (см. HANDOFF.md).

dns_up() {
	local d
	mkdir -p "$DNSMASQ_DIR"
	: > "$DNSMASQ_CONF"
	# Обе семьи — ОДНОЙ директивой nftset= на домен, через запятую
	# (4#...,6#...). Две отдельные директивы nftset= для одного и того же
	# домена не складываются: dnsmasq запоминает только первую, вторая
	# молча теряется — проверено вживую на стенде (AAAA-ответы приходили,
	# но vless6_dns оставался пустым, пока директивы не объединили).
	[ -f "$domains" ] && sed -e 's/#.*//' -e 's/[[:space:]]//g' "$domains" \
		| grep -v '^$' | while read -r d; do
			echo "nftset=/$d/4#inet#fw4#vless4_dns,6#inet#fw4#vless6_dns" >> "$DNSMASQ_CONF"
		done
	# Важно: именно restart, не reload. SIGHUP (reload) не пересобирает
	# внутреннюю структуру сопоставления доменов для nftset= — новые
	# домены из confdir при reload просто не подхватываются (найдено и
	# проверено вживую при разработке основного варианта, см. HANDOFF.md).
	/etc/init.d/dnsmasq restart
}

dns_down() {
	rm -f "$DNSMASQ_CONF"
	/etc/init.d/dnsmasq restart
}

# Xray стартует не мгновенно, а правила без слушателя = чёрная дыра для
# всего, что в списках. Ждём порт, прежде чем включать перехват.
wait_for_port() {
	local i=0
	while [ "$i" -lt 10 ]; do
		netstat -ln 2>/dev/null | grep -q ":$tproxy_port " && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

start_service() {
	load_cfg
	[ "$enabled" = "1" ] || { echo "vless-tunnel: выключен в /etc/config/$CONF"; return 0; }
	[ -x "$XRAY_BIN" ]   || { echo "vless-tunnel: нет $XRAY_BIN"; return 1; }

	# В этом варианте config.json от domains/subnets не зависит (решение
	# принимает nftables, не Xray) — _build-config просто пересобирает его
	# из сохранённой ссылки, идемпотентно.
	"$BIN" _build-config || {
		echo "vless-tunnel: нет конфига — vless-tunnel set-link \"vless://...\""; return 1; }

	"$XRAY_BIN" run -test -c "$CONFIG_JSON" >/dev/null 2>&1 || {
		echo "vless-tunnel: ядро отвергло $CONFIG_JSON"; return 1; }

	procd_open_instance xray
	procd_set_param command "$XRAY_BIN" run -c "$CONFIG_JSON"
	# geo-файлы не ставим вовсе: маршрутизация решается в nftables,
	# а geosite.dat съел бы и флеш, и десятки мегабайт RAM
	procd_set_param env GOMEMLIMIT=48MiB
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_started() {
	load_cfg
	[ "$enabled" = "1" ] || return 0
	wait_for_port || {
		echo "vless-tunnel: ядро не слушает $tproxy_port — перехват не включаю"
		return 1
	}
	route_up
	sets_load
	dns_up
}

stop_service() {
	load_cfg
	dns_down
	route_down
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}

reload_service() {
	stop
	start
}
