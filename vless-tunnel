const TEST_PORT = 18080;
const TEST_TARGET = '1.1.1.1';

function fail(msg) {
	die(msg);
}

// --- percent-decoding -------------------------------------------------
// ucode не умеет декодировать URI из коробки (нет uri_decode). plus_space
// включает декодирование '+' в пробел — так себя ведёт разбор query string
// (application/x-www-form-urlencoded), но не userinfo/host/fragment.
function hex_val(c) {
	let o = ord(c);
	if (o >= 48 && o <= 57) return o - 48;       // 0-9
	if (o >= 97 && o <= 102) return o - 87;      // a-f
	if (o >= 65 && o <= 70) return o - 55;       // A-F
	return -1;
}

// ucode int() не парсит "0x..."-строки (возвращает 0) — нужен свой разбор
// для сверки fwmark из UCI (строка вида "0x1e5") с тем, что реально
// напечатает `nft list` (нормализованный "0x000001e5").
function hex_to_int(s) {
	s = lc(trim(s ?? ''));
	if (index(s, '0x') == 0) s = substr(s, 2);
	let n = 0;
	for (let i = 0; i < length(s); i++) {
		let v = hex_val(substr(s, i, 1));
		if (v < 0) return null;
		n = n * 16 + v;
	}
	return n;
}

// Есть ли в выводе `ip [-6] rule list` правило с этими fwmark/table —
// сравнение по значению (hex_to_int), не строкой: "0x1e5"/"0x01e5"/"485"
// в UCI значат одно и то же, а `ip rule` печатает нормализованно.
function has_fwmark_rule(text, mark, table) {
	// match() без /g вернул бы только первое совпадение во всём выводе —
	// правила печатаются по возрастанию priority, и чужое fwmark-правило
	// с меньшим приоритетом (mwan3, форк podkop — оба заводят свои)
	// встало бы в выводе раньше и подменило бы собой то, что реально
	// проверяем. Идём по строкам, ищем среди всех.
	for (let line in split(text ?? '', '
')) {
		let m = match(line, /fwmark (0x[0-9a-fA-F]+) lookup ([0-9]+)/);
		if (m && hex_to_int(m[1]) == hex_to_int(mark) && int(m[2]) == int(table))
			return true;
	}
	return false;
}

function pct_decode(s, plus_space) {
	s = '' + (s ?? '');
	let out = '';
	let n = length(s);
	for (let i = 0; i < n; i++) {
		let c = substr(s, i, 1);
		if (plus_space && c == '+') {
			out += ' ';
			continue;
		}
		if (c == '%' && i + 2 < n) {
			let hi = hex_val(substr(s, i + 1, 1));
			let lo = hex_val(substr(s, i + 2, 1));
			if (hi >= 0 && lo >= 0) {
				out += chr(hi * 16 + lo);
				i += 2;
				continue;
			}
		}
		out += c;
	}
	return out;
}

function is_ipv4(s) {
	return match(s, /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) != null &&
		!length(filter(split(s, '.'), (p) => int(p) > 255));
}

function is_ipv6(s) {
	// Достаточно грубой проверки: это не адрес назначения, а флаг для
	// "резолвить сервер по домену или нет" (host_is_ip в build_config).
	return index(s, ':') >= 0 && match(s, /^[0-9a-fA-F:]+$/) != null;
}

function is_ip(s) {
	return is_ipv4(s) || is_ipv6(s);
}

function split_hostport(hp) {
	hp = trim(hp ?? '');
	let host, port;
	if (substr(hp, 0, 1) == '[') {
		let close = index(hp, ']');
		if (close < 0) fail('некорректный IPv6-адрес в ссылке');
		host = substr(hp, 1, close - 1);
		let rest = substr(hp, close + 1);
		port = substr(rest, 0, 1) == ':' ? substr(rest, 1) : '';
	} else {
		let first = index(hp, ':');
		let last = rindex(hp, ':');
		if (first < 0) {
			host = hp;
			port = '';
		} else if (first != last) {
			// два и больше ':' без скобок — это голый IPv6, порта нет
			host = hp;
			port = '';
		} else {
			host = substr(hp, 0, first);
			port = substr(hp, first + 1);
		}
	}
	return [pct_decode(trim(host)), trim(port)];
}

// --- разбор ссылки ------------------------------------------------------
function parse_link(raw) {
	raw = trim(trim(trim(raw ?? ''), '"'), "'");
	let m = match(raw, /vless:\/\//i);
	if (!m) fail('ожидается ссылка, начинающаяся с vless://');
	let idx = index(lc(raw), 'vless://');
	let link = replace(substr(raw, idx), /\s+/g, '');
	if (!link || match(link, /^vless:\/\/\s*$/i))
		fail('ссылка пустая');

	let body = substr(link, length('vless://'));
	let frag = '';
	let hashPos = index(body, '#');
	if (hashPos >= 0) {
		frag = pct_decode(substr(body, hashPos + 1));
		body = substr(body, 0, hashPos);
	}
	let qs = '';
	let qPos = index(body, '?');
	if (qPos >= 0) {
		qs = substr(body, qPos + 1);
		body = substr(body, 0, qPos);
	}
	let atPos = rindex(body, '@');
	if (atPos < 0) fail('в ссылке нет части «UUID@хост:порт»');
	let uuid = pct_decode(trim(substr(body, 0, atPos)));
	let hp = split_hostport(substr(body, atPos + 1));
	let host = hp[0];
	let portStr = hp[1];
	if (!uuid) fail('в ссылке не указан UUID');
	if (!host) fail('в ссылке не указан адрес сервера');
	let port = portStr ? int(portStr) : 443;
	if (type(port) != 'int' || port < 1 || port > 65535)
		fail('некорректный порт: ' + portStr);

	let q = {};
	if (qs) {
		for (let pair in split(qs, '&')) {
			if (!pair) continue;
			let eq = index(pair, '=');
			let k = lc(trim(pct_decode(eq >= 0 ? substr(pair, 0, eq) : pair, true)));
			let v = eq >= 0 ? pct_decode(substr(pair, eq + 1), true) : '';
			if (k) q[k] = v;
		}
	}

	let net = lc(trim(q.type || q.network || 'tcp'));
	if (net == 'h2' || net == 'http2') net = 'http';
	if (net == '') net = 'tcp';
	if (!(net in {tcp:1,raw:1,ws:1,grpc:1,http:1,quic:1,kcp:1,httpupgrade:1,xhttp:1,splithttp:1}))
		fail('неизвестный транспорт type=' + net);

	let security = lc(trim(q.security || 'none'));
	if (security == '' || security == 'auto') security = 'none';
	if (security == 'xtls') security = 'tls';
	if (!(security in {none:1, tls:1, reality:1}))
		fail('неизвестный security=' + security + ' (ожидается none, tls или reality)');

	let alpn = [];
	for (let a in split(q.alpn || '', /[,\s]+/))
		if (a) push(alpn, a);

	let p = {
		link: link,
		name: frag,
		uuid: uuid,
		host: host,
		port: port,
		host_is_ip: is_ip(host),
		network: net,
		security: security,
		encryption: trim(q.encryption || '') || 'none',
		flow: trim(q.flow || ''),
		sni: trim(q.sni || ''),
		alpn: alpn,
		fp: trim(q.fp || ''),
		pbk: trim(q.pbk || ''),
		sid: trim(q.sid || ''),
		spx: trim(q.spx || ''),
		pqv: trim(q.pqv || ''),
		path: trim(q.path || ''),
		host_header: trim(q.host || ''),
		service: trim(q.servicename || ''),
		mode: lc(trim(q.mode || '')),
		header_type: lc(trim(q.headertype || '')),
		key: trim(q.key || ''),
		seed: trim(q.seed || ''),
		extra: trim(q.extra || ''),
		allow_insecure: lc(trim(q.allowinsecure || '')) in {'1':1, 'true':1, 'yes':1, 'on':1},
		ech: trim(q.ech || ''),
	};

	if (security == 'reality') {
		if (!p.pbk) fail('в ссылке security=reality, но не указан publicKey (pbk)');
		if (!(net in {tcp:1, raw:1, http:1, xhttp:1, splithttp:1, grpc:1}))
			fail('REALITY не поддерживается с транспортом ' + net);
	}
	if (!(p.flow in {'':1, 'xtls-rprx-vision':1, 'xtls-rprx-vision-udp443':1}))
		fail('неизвестный flow=' + p.flow);
	if (p.flow && security == 'none')
		fail('flow=' + p.flow + ' требует security=tls или security=reality');

	return p;
}

// --- streamSettings -------------------------------------------------
function build_stream(p) {
	let net = p.network == 'raw' ? 'tcp' : p.network;
	let st = { network: net };
	let host_hdr = p.host_header || p.sni;

	if (net == 'tcp') {
		if (p.header_type == 'http') {
			let req = { path: [p.path || '/'], headers: {} };
			if (p.host_header) req.headers.Host = [p.host_header];
			st.tcpSettings = { header: { type: 'http', request: req } };
		}
	} else if (net == 'ws') {
		let s = {};
		if (p.path) s.path = p.path;
		if (host_hdr) s.host = host_hdr;
		st.wsSettings = s;
	} else if (net == 'grpc') {
		let s = {};
		if (p.service) s.serviceName = p.service;
		if (p.mode == 'multi') s.multiMode = true;
		st.grpcSettings = s;
	} else if (net == 'http') {
		let s = {};
		if (host_hdr) s.host = filter(split(host_hdr, ','), (x) => x);
		if (p.path) s.path = p.path;
		st.httpSettings = s;
	} else if (net == 'quic') {
		st.quicSettings = {
			security: 'none',
			key: p.key,
			header: { type: p.header_type || 'none' },
		};
	} else if (net == 'kcp') {
		let s = {};
		if (p.header_type && p.header_type != 'none') s.header = { type: p.header_type };
		if (p.seed) s.seed = p.seed;
		st.kcpSettings = s;
	} else if (net == 'httpupgrade') {
		let s = {};
		if (p.path) s.path = p.path;
		if (host_hdr) s.host = host_hdr;
		st.httpupgradeSettings = s;
	} else if (net == 'xhttp' || net == 'splithttp') {
		let s = {};
		if (p.path) s.path = p.path;
		if (host_hdr) s.host = host_hdr;
		if (p.mode) s.mode = p.mode;
		if (p.extra) {
			try {
				let extra = json(p.extra);
				if (type(extra) == 'object') s.extra = extra;
			} catch (e) {
				warn('предупреждение: параметр extra не разобран как JSON, пропущен\n');
			}
		}
		st[net == 'xhttp' ? 'xhttpSettings' : 'splithttpSettings'] = s;
	}

	if (p.security == 'reality') {
		let rs = {
			serverName: p.sni || p.host_header || p.host,
			fingerprint: p.fp || 'chrome',
			publicKey: p.pbk,
			shortId: p.sid,
			spiderX: p.spx || '/',
		};
		if (p.pqv) rs.mldsa65Verify = p.pqv;
		st.security = 'reality';
		st.realitySettings = rs;
	} else if (p.security == 'tls') {
		let ts = { serverName: p.sni || p.host_header || p.host };
		if (p.fp) ts.fingerprint = p.fp;
		if (length(p.alpn)) ts.alpn = p.alpn;
		if (p.allow_insecure) ts.allowInsecure = true;
		if (p.ech) ts.echConfigList = p.ech;
		st.security = 'tls';
		st.tlsSettings = ts;
	} else {
		st.security = 'none';
	}

	// quic и kcp идут поверх UDP — TCP-опция им ни к чему.
	if (!(net in { quic: 1, kcp: 1 }))
		st.sockopt = { tcpUserTimeout: TCP_USER_TIMEOUT_MS };
	return st;
}

// Xray с flow=xtls-rprx-vision сам отклоняет UDP/443 (QUIC). Суффикс
// -udp443 — чисто клиентский флаг (сервер видит xtls-rprx-vision), без
// него QUIC/HTTP-3 через туннель не работает.
function effective_flow(p) {
	if (p.flow == 'xtls-rprx-vision') return 'xtls-rprx-vision-udp443';
	return p.flow;
}

// --- мелкие обёртки над fs / shell --------------------------------------
function read_file(path) {
	let f = fs.open(path, 'r');
	if (!f) return null;
	let data = f.read('all');
	f.close();
	return data;
}

function write_file(path, data) {
	let f = fs.open(path, 'w');
	if (!f) fail('не удалось открыть на запись: ' + path + ' (' + fs.error() + ')');
	f.write(data);
	f.close();
}

// config.json содержит UUID/ключи ссылки сервера — не должен быть
// читаем кем попало на многопользовательской системе.
function write_config_json(data) {
	write_file(CONFIG_JSON, data);
	fs.chmod(CONFIG_JSON, 0600);
}

function ensure_dir(path) {
	fs.access(path) || fs.mkdir(path);
}

// Шаблон списка создаём только если файла ещё нет — не затираем то, что
// пользователь уже заполнил через predыдущий setup/set-link.
function ensure_list_file(path, template) {
	fs.access(path) || write_file(path, template);
}

// Список -> массив записей. Комментарии (#...) и пустые строки выкидываем.
function read_list(path) {
	let text = read_file(path);
	if (!text) return [];
	let out = [];
	for (let line in split(text, '\n')) {
		line = trim(replace(line, /#.*/, ''));
		if (line) push(out, line);
	}
	return out;
}

// --- config.json ------------------------------------------------------
// TPROXY в nftables перехватывает уже весь TCP/UDP из LAN (кроме
// приватных сетей и bypass) — здесь, внутри Xray, решаем, что из этого
// реально идёт в туннель. domains/subnets вставляются как inline-списки
// в routing.rules, без geosite.dat: `domain:` — суффиксное совпадение
// (поддомены автоматически), `ip` — точный/CIDR-адрес. Sniffing с
// routeOnly:true берёт домен из TLS SNI/HTTP Host самого соединения —
// не из DNS-ответа, поэтому не зависит от того, как клиент резолвил адрес
// (в частности, устойчиво к DNS-over-HTTPS в обход роутера — см. HANDOFF).
//
// В режиме dns sniffing и доменных правил нет: в TPROXY и так попадает
// только то, что nftables решил тоннелировать, — всё это идёт в туннель.
function build_config(p, o) {
	let flow = effective_flow(p);
	let user = { id: p.uuid, encryption: p.encryption || 'none' };
	if (flow) user.flow = flow;

	let proxy_out = {
		tag: 'proxy',
		protocol: 'vless',
		settings: { vnext: [{ address: p.host, port: p.port, users: [user] }] },
		streamSettings: build_stream(p),
		mux: { enabled: false },
	};
	let direct_out = { tag: 'direct', protocol: 'freedom', settings: {} };

	// Тот же сервер для DNS-запросов dnsmasq (dns-in), но с XUDP: каждый
	// запрос уходит с нового порта, то есть это отдельная UDP-сессия, и без
	// мультиплексирования каждая открывала бы своё соединение до сервера —
	// на стенде ~340 мс на запрос против ~110 мс с XUDP. concurrency -1: TCP
	// не мультиплексируется (и так совместимо с flow vision), только UDP.
	// Тег НЕ должен начинаться с "proxy": selector балансеров и
	// subjectSelector observatory сравнивают по префиксу, и балансер tunnel
	// иначе раздавал бы обычный трафик LAN и через этот outbound.
	let dns_out = null;
	if (o.tunnel_dns) {
		dns_out = json(sprintf('%J', proxy_out));
		dns_out.tag = 'dns-proxy';
		dns_out.mux = { enabled: true, concurrency: -1, xudpConcurrency: 8 };
	}

	// «В туннель» при fallback=1 — не сам proxy-outbound, а балансер над
	// ним с fallbackTag=direct: когда проба observatory через сервер не
	// проходит (VPS лёг, путь «дом ↔ VPS» режется), балансер отдаёт трафик
	// напрямую, а не в мёртвый туннель. Иначе в mode=proxy при обрыве у
	// всей квартиры пропадает весь зарубежный веб (см. HANDOFF, «Инцидент
	// 25.10.2026»). Сразу после старта, до первой пробы, сервер считается
	// живым — проверено на стенде.
	let fallback = o.fallback !== false;
	let tunnel = (r) => {
		if (fallback) r.balancerTag = 'tunnel';
		else r.outboundTag = 'proxy';
		return r;
	};

	let domainRules = [];
	for (let d in (o.domains || [])) push(domainRules, 'domain:' + d);
	let directRules = [];
	for (let d in (o.direct_domains || [])) push(directRules, 'domain:' + d);
	let ipRules = o.subnets || [];

	let rules = [];
	// DNS-запросы dnsmasq к доменам из списка (см. dnsmasq_text) — в туннель.
	// Свой балансер: если сервер недоступен, такой запрос уходит не на
	// dns_upstream напрямую, а на DNS провайдера (dns-direct). Прямой запрос
	// к 1.1.1.1 из дома для части доменов подменяется на пути (youtube.com →
	// NXDOMAIN, проверено 26.10.2026), а провайдерский резолвер на них
	// отвечает честно.
	if (o.tunnel_dns)
		push(rules, fallback
			? { type: 'field', inboundTag: ['dns-in'], balancerTag: 'tunnel-dns' }
			: { type: 'field', inboundTag: ['dns-in'], outboundTag: 'dns-proxy' });

	if (o.mode == 'dns') {
		push(rules, tunnel({ type: 'field', network: 'tcp,udp' }));
	} else {
		// Сервер туннеля — напрямую. Основной обход — в nftables
		// (vless4_server, трафик до Xray вообще не доходит); это страховка
		// на случай, если сеты не обновились. Работает только при
		// routeOnly=1: при 0 у sniffed-соединения вместо IP уже домен.
		if (length(o.server_ips))
			push(rules, { type: 'field', ip: o.server_ips, outboundTag: 'direct' });

		// Явные исключения «всегда напрямую» — раньше остальных правил.
		// Сюда попадает то, что должно идти мимо туннеля даже при
		// mode=proxy: банки/госуслуги, сервисы с капчей на датацентровый IP,
		// большие CDN, которым важна скорость. Приоритет выше «всегда в
		// туннель» (domains), чтобы исключение можно было поставить, не
		// вычищая домен из domains.
		if (length(directRules))
			push(rules, { type: 'field', domain: directRules, outboundTag: 'direct' });

		if (length(domainRules))
			push(rules, tunnel({ type: 'field', domain: domainRules }));
		if (length(ipRules))
			push(rules, tunnel({ type: 'field', ip: ipRules }));

		if (o.mode == 'proxy') {
			// Режим «в туннель всё, что не RU и не исключение». Новые
			// заблокированные сайты (xda, aethus, что угодно ещё) не нужно
			// вписывать руками — они зарубежные и потому идут в proxy.
			// RU-домены и RU-адреса — напрямую: банки/госуслуги не любят
			// зарубежные IP, а прямой путь ещё и быстрее.
			push(rules, { type: 'field',
				domain: ['domain:ru', 'domain:su', 'domain:xn--p1ai'],
				outboundTag: 'direct' });
			if (o.geoip_ok)
				push(rules, { type: 'field', ip: ['geoip:ru'], outboundTag: 'direct' });

			// Весь остальной веб — в туннель. Нестандартные порты остаются
			// direct (торренты, игры, ssh не гоняем через туннель); если
			// такой сервис заблокирован — его IP добавляется в subnets.
			push(rules, tunnel({ type: 'field', network: 'tcp', port: '80,443,8443' }));
			push(rules, tunnel({ type: 'field', network: 'udp', port: '443' }));
		}
		push(rules, { type: 'field', network: 'tcp,udp', outboundTag: 'direct' });
	}

	// routeOnly=1 по умолчанию. 0 включается вручную (UCI route_only=0),
	// когда провайдер подменяет DNS-ответы: тогда домен уходит на резолв
	// серверу. Важная плата: при routeOnly=0 у sniffed-соединений больше
	// нет IP назначения, и правило geoip:ru не срабатывает — RU-сайты на
	// .com (vk.com и т.п.) придётся вписать в direct-domains.
	let route_only = (type(o.route_only) == 'bool') ? o.route_only : true;
	let sniffing = { enabled: true, destOverride: ['http', 'tls', 'quic'],
		routeOnly: route_only };

	// Access-лог (строка на КАЖДОЕ соединение) Xray без явного `access`
	// пишет в stdout, а procd — в syslog: при торрентах это тысячи строк в
	// минуту в logd. Нужен он только для отладки маршрутизации.
	let log_level = o.log_level || 'warning';
	let log = { loglevel: log_level };
	if (!(log_level in { debug: 1, info: 1 })) log.access = 'none';

	let inbounds = [{
		tag: 'tproxy-in',
		// TPROXY доставляет пакет "локально" по destination IP клиента,
		// который почти никогда не равен 127.0.0.1 — сокет обязан
		// слушать на 0.0.0.0, иначе ядро не находит слушателя.
		listen: '0.0.0.0',
		port: o.tproxy_port,
		protocol: 'dokodemo-door',
		settings: { network: 'tcp,udp', followRedirect: true },
		streamSettings: { sockopt: { tproxy: 'tproxy' } },
	}, {
		// Зеркало tproxy-in для IPv6 — тот же приём: слушать нужно на
		// "::" (wildcard), не "::1", иначе TPROXY-доставка по чужому
		// destination-адресу молча проваливается, ровно как с
		// 0.0.0.0/127.0.0.1 у v4-инбаунда выше.
		tag: 'tproxy-in6',
		listen: '::',
		port: o.tproxy_port,
		protocol: 'dokodemo-door',
		settings: { network: 'tcp,udp', followRedirect: true },
		streamSettings: { sockopt: { tproxy: 'tproxy' } },
	}];
	// routeOnly: домен из sniffing участвует только в выборе outbound'а
	// (routing.rules выше), а реальное соединение (что в proxy, что в
	// direct) идёт на исходный IP, который уже увидел TPROXY — без этого
	// direct-путь потребовал бы своего DNS-резолва внутри Xray, которого мы
	// сознательно избегаем.
	if (o.mode != 'dns')
		for (let ib in inbounds) ib.sniffing = sniffing;

	// Прозрачный форвард на публичный резолвер: dnsmasq шлёт сюда запросы к
	// доменам из списка (server=/домен/127.0.0.1#dns_port), а routing
	// отправляет их в туннель — ответ приходит от резолвера с VPS, без
	// подмены провайдером и с CDN-адресами рядом с сервером, куда этот
	// трафик потом и пойдёт. userLevel 1: каждый запрос dnsmasq уходит с
	// нового порта, то есть это отдельная UDP-«сессия» (в XUDP dns-proxy) —
	// с connIdle по умолчанию (300 с) они копились бы сотнями.
	if (o.tunnel_dns)
		push(inbounds, {
			tag: 'dns-in',
			listen: '127.0.0.1',
			port: o.dns_port,
			protocol: 'dokodemo-door',
			settings: { address: o.dns_upstream, port: 53, network: 'tcp,udp', userLevel: 1 },
		});

	let routing = { domainStrategy: 'AsIs', rules: rules };
	let outbounds = [proxy_out, direct_out];
	if (dns_out) push(outbounds, dns_out);
	let cfg = {
		log: log,
		inbounds: inbounds,
		outbounds: outbounds,
		routing: routing,
		policy: { levels: {
			'0': { bufferSize: 4 },
			'1': { bufferSize: 4, connIdle: 10, uplinkOnly: 1, downlinkOnly: 1 },
		} },
	};
	if (fallback) {
		// random с одним кандидатом — то же, что proxy, пока observatory
		// считает его живым; мёртвый отфильтровывается, и остаётся
		// fallbackTag. leastPing не подходит: до первой пробы у него нет
		// данных, и первые секунды после старта всё ушло бы в direct.
		routing.balancers = [{ tag: 'tunnel', selector: ['proxy'],
			strategy: { type: 'random' }, fallbackTag: 'direct' }];
		if (o.tunnel_dns) {
			push(routing.balancers, { tag: 'tunnel-dns', selector: ['dns-proxy'],
				strategy: { type: 'random' }, fallbackTag: o.isp_dns ? 'dns-direct' : 'direct' });
			if (o.isp_dns)
				push(outbounds, { tag: 'dns-direct', protocol: 'freedom',
					settings: { redirect: o.isp_dns + ':53' } });
		}
		// enableConcurrency: без него observatory проверяет outbound'ы по
		// одному за интервал — proxy и dns-proxy узнавали бы о падении и
		// возврате сервера с разницей до минуты (видно на стенде).
		cfg.observatory = { subjectSelector: dns_out ? ['proxy', 'dns-proxy'] : ['proxy'],
			probeUrl: PROBE_URL, probeInterval: PROBE_INTERVAL, enableConcurrency: true };
		cfg.metrics = { tag: 'metrics', listen: METRICS_ADDR };
	}
	return cfg;
}

function summary(p) {
	return sprintf(
		'NETWORK=%s\nSECURITY=%s\nSERVER=%s\nSERVER_PORT=%d\nSERVER_IS_IP=%s\n' +
		'NAME=%s\nSNI=%s\nFLOW=%s\nENCRYPTION=%s\nALLOW_INSECURE=%s\n',
		p.network, p.security, p.host, p.port, p.host_is_ip ? 'true' : 'false',
		replace(p.name, '\n', ' '), (p.sni || p.host_header), p.flow, p.encryption,
		p.allow_insecure ? 'true' : 'false'
	);
}

// Выполняет команду, отдаёт { code, output } — вывод и stderr вместе.
function run_capture(cmd) {
	let p = fs.popen(cmd + ' 2>&1', 'r');
	if (!p) return { code: -1, output: '' };
	let out = p.read('all') || '';
	let code = p.close();
	return { code: code, output: out };
}

// Запускает команду в фоне, не дожидаясь завершения, возвращает PID.
// stdin/stdout/stderr фонового процесса обязаны быть переопределены —
// иначе он может умереть вместе с закрытием нашего popen-канала.
function run_background(cmd, log) {
	let p = fs.popen("sh -c '" + cmd + " </dev/null >" + log + " 2>&1 & echo $!'", 'r');
	let pid = trim(p.read('all') ?? '');
	p.close();
	return pid;
}

function port_listening(port) {
	let hex = uc(sprintf('%04x', port));
	for (let path in ['/proc/net/tcp', '/proc/net/tcp6']) {
		let data = read_file(path);
		if (!data) continue;
		for (let line in split(data, '\n')) {
			let cols = split(trim(replace(line, /[ \t]+/g, ' ')), ' ');
			if (length(cols) < 4) continue;
			let addr = split(cols[1], ':');
			if (length(addr) == 2 && uc(addr[1]) == hex && cols[3] == '0A')
				return true;
		}
	}
	return false;
}

// --- сервер туннеля — мимо Xray -----------------------------------------
// Трафик LAN к самому серверу туннеля не должен попадать в Xray роутера.
// Десктопный клиент или VPN-приложение на телефоне с той же ссылкой ходят
// на этот же сервер, и роутер заворачивал их соединения в свой туннель:
// REALITY-маскировка (SNI вроде www.sap.com) совпадала с domains, а в
// mode=proxy под «весь веб — в proxy» попадает вообще любое такое
// соединение. Сервер, получив его изнутри туннеля, по sniffing подменял
// адрес назначения на настоящий www.sap.com — клиент видел чужой
// сертификат и рвал связь. Итог — «за роутером не работает ничего».
// См. HANDOFF.md, «Тест 25.10.2026: туннель в туннеле».

// Адреса сервера из ссылки. Домен резолвится DNS самого роутера (busybox
// nslookup); при неудаче — пустой список, вызывающий решает, что делать.
function server_ips(p) {
	if (p.host_is_ip) return [p.host];
	// host идёт в командную строку — пускаем только то, что похоже на имя
	if (!match(p.host, /^[A-Za-z0-9.-]+$/)) return [];
	let r = run_capture('nslookup ' + p.host);
	if (r.code != 0) return [];
	let ips = [], answer = false;
	for (let line in split(r.output, '\n')) {
		// до "Name:" идут строки самого DNS-сервера (Address: 127.0.0.1:53)
		if (match(line, /^Name:/)) answer = true;
		let m = answer ? match(line, /^Address:[ \t]*([0-9A-Fa-f.:]+)[ \t]*$/) : null;
		if (m && is_ip(m[1]) && !(m[1] in ips)) push(ips, m[1]);
	}
	return ips;
}

function nft_set_decl(name, type, ips) {
	return 'set ' + name + ' {\n\ttype ' + type + '\n' +
		(length(ips) ? '\telements = { ' + join(', ', ips) + ' }\n' : '') + '}\n';
}

// Кладёт адреса сервера в vless4_server/vless6_server: в живой ruleset —
// сразу, и в SERVER_NFT_FILE — чтобы они пережили `fw4 reload` и
// перезагрузку (fw4 пересобирает таблицу из /etc/nftables.d с нуля, и
// добавленные на лету элементы пропадают). Сами сеты объявлены пустыми в
// NFT_FILE; здесь они объявляются повторно уже с элементами — для nft это
// add, элементы добавляются к существующему сету.
function sync_server_bypass(ips) {
	let v4 = filter(ips, is_ipv4), v6 = filter(ips, (a) => !is_ipv4(a));
	let decl = nft_set_decl('vless4_server', 'ipv4_addr', v4) +
		nft_set_decl('vless6_server', 'ipv6_addr', v6);

	let tmp = '/tmp/vless-tunnel-server.nft';
	write_file(tmp, 'table inet fw4 {\n' + decl + '}\n');
	let chk = run_capture('nft -c -f ' + tmp);
	if (chk.code != 0) {
		fs.unlink(tmp);
		warn('предупреждение: IP сервера не добавлен в обход Xray (nft отверг):\n' + chk.output);
		return false;
	}

	let body = '# сгенерировано vless-tunnel _build-config, не править\n' + decl;
	if (read_file(SERVER_NFT_FILE) != body)
		write_file(SERVER_NFT_FILE, body);

	// flush + add одной транзакцией: старый адрес (после set-link на другой
	// сервер) не остаётся висеть в обходе
	let live = 'flush set inet fw4 vless4_server\nflush set inet fw4 vless6_server\n';
	if (length(v4)) live += 'add element inet fw4 vless4_server { ' + join(', ', v4) + ' }\n';
	if (length(v6)) live += 'add element inet fw4 vless6_server { ' + join(', ', v6) + ' }\n';
	write_file(tmp, live);
	let r = run_capture('nft -f ' + tmp);
	fs.unlink(tmp);
	if (r.code != 0) {
		warn('предупреждение: живые сеты vless4_server/vless6_server не обновлены — ' +
			'nft-файл старый? переустановите (sh install.sh):\n' + r.output);
		return false;
	}
	return true;
}

// --- UCI: /etc/config/vless-tunnel --------------------------------------
function cfg_defaults() {
	return {
		enabled: '0', link: '', lan: 'br-lan', tproxy_port: '12345',
		fwmark: '0x1e5', table: '100',
		// whitelist — в туннель только domains/subnets (обратная
		// совместимость); proxy — в туннель весь веб, кроме RU и
		// явных исключений direct-domains; dns — решение по DNS в nftables.
		mode: 'whitelist', log_level: 'warning',
		// route_only: '1' (по умолчанию) — соединяться с IP, который
		// увидел TPROXY; '0' — отдавать домен на резолв прокси/серверу
		// (лечит подменённый DNS, но ломает geoip:ru для sniffed-трафика).
		route_only: '1',
		// fallback: '1' — сервер недоступен → туннельный трафик напрямую.
		fallback: '1',
		// tunnel_dns: '1' — DNS доменов из domains через туннель, на
		// dns_upstream (с VPS), через dns-in Xray на 127.0.0.1:dns_port.
		tunnel_dns: '1', dns_port: '5359', dns_upstream: '1.1.1.1',
		domains: DOMAINS_DEFAULT, subnets: SUBNETS_DEFAULT,
		direct_domains: DIRECT_DOMAINS_DEFAULT, geoip: GEOIP_DEFAULT,
	};
}

const MODES = { whitelist: 1, proxy: 1, dns: 1 };

function mode_title(mode) {
	if (mode == 'proxy') return 'proxy (весь веб в туннель, кроме RU и direct-domains)';
	if (mode == 'dns') return 'dns (в туннель domains/subnets, решение по DNS в nftables)';
	return 'whitelist (в туннель только domains/subnets)';
}

function cfg_get_all() {
	let d = cfg_defaults();
	try {
		let c = uci.cursor();
		let cur = c.get_all(UCI_CONF, 'main');
		if (cur) for (let k in d) if (cur[k] != null) d[k] = cur[k];
	} catch (e) { }
	return d;
}

// Создаёт секцию 'main' с дефолтами, если её ещё нет — идемпотентно,
// безопасно звать из любой команды, которой нужен конфиг.
function cfg_ensure() {
	fs.access('/etc/config/' + UCI_CONF) || write_file('/etc/config/' + UCI_CONF, '');
	let c = uci.cursor();
	if (!c.get_all(UCI_CONF, 'main')) {
		c.set(UCI_CONF, 'main', 'tunnel');
		let d = cfg_defaults();
		for (let k in d) c.set(UCI_CONF, 'main', k, d[k]);
		c.commit(UCI_CONF);
	}
	return c;
}

function cfg_set(kv) {
	let c = cfg_ensure();
	for (let k in kv) c.set(UCI_CONF, 'main', k, kv[k]);
	c.commit(UCI_CONF);
}

// Читает domains/subnets заново при каждом вызове — правки в этих файлах
// применяются к routing.rules сразу при следующей пересборке config.json
// (set-link, on, либо явный _build-config), без отдельной "перезагрузки
// списков" как раньше у dnsmasq.
// Первый IPv4-резолвер провайдера (пришёл по DHCP/PPPoE) — на него идут DNS-
// запросы доменов из списка, пока сервер недоступен (см. dns-direct в
// build_config). Адрес берётся при сборке config.json; сменится после
// переподключения WAN — подхватится при следующем старте службы.
const RESOLV_AUTO = '/tmp/resolv.conf.d/resolv.conf.auto';

function isp_dns() {
	for (let line in split(read_file(RESOLV_AUTO) ?? '', '\n')) {
		let m = match(line, /^nameserver[ \t]+([0-9.]+)[ \t]*$/);
		if (m && is_ipv4(m[1]) && !match(m[1], /^127\./)) return m[1];
	}
	return null;
}

function default_opts() {
	let cfg = cfg_get_all();
	let dns_port = int(cfg.dns_port);
	return {
		mode: (cfg.mode in MODES) ? cfg.mode : 'whitelist',
		tproxy_port: int(cfg.tproxy_port),
		log_level: cfg.log_level || 'warning',
		route_only: (cfg.route_only == '0') ? false : (cfg.route_only == '1') ? true : null,
		fallback: cfg.fallback != '0',
		// Битые dns_port/dns_upstream в UCI — DNS через туннель просто
		// выключается, а не валит сборку config.json.
		tunnel_dns: cfg.tunnel_dns != '0' && dns_port > 0 && dns_port < 65536 &&
			is_ip(cfg.dns_upstream),
		dns_port: dns_port,
		dns_upstream: cfg.dns_upstream,
		isp_dns: isp_dns(),
		domains: read_list(cfg.domains),
		direct_domains: read_list(cfg.direct_domains),
		subnets: read_list(cfg.subnets),
		geoip: cfg.geoip,
		geoip_ok: !!fs.access(cfg.geoip),
	};
}

function service_running() {
	return system(INIT_SCRIPT + ' status >/dev/null 2>&1') == 0;
}

// --- dnsmasq: DNS доменов из списка через туннель, nftset= для mode=dns ----
// Файл кладётся в conf-dir первого экземпляра dnsmasq и живёт, пока служба
// работает: _dns-up зовёт init после старта Xray, _dns-down — при остановке.
// dhcp UCI не трогаем: каталог берём тот же, что выбирает /etc/init.d/dnsmasq
// (confdir из UCI, иначе /tmp/dnsmasq.<имя секции>.d).

function dnsmasq_confdir() {
	let dir = null;
	try {
		uci.cursor().foreach('dhcp', 'dnsmasq', (s) => {
			dir = s.confdir ? split(s.confdir, ',')[0] : '/tmp/dnsmasq.' + s['.name'] + '.d';
			return false;
		});
	} catch (e) { }
	return (dir && substr(dir, 0, 1) == '/') ? dir : null;
}

function dnsmasq_has_nftset() {
	let out = run_capture('dnsmasq --version').output;
	return index(out, 'no-nftset') < 0 && index(out, 'nftset') >= 0;
}

// Строка списка уходит в конфиг dnsmasq как часть server=/…/ — пропускаем
// только то, что похоже на имя, иначе один кривой домен уронит dnsmasq.
function is_dns_name(d) {
	return match(d, /^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+$/) != null;
}

// null — писать нечего (DNS через туннель выключен и режим не dns).
function dnsmasq_text(p, o) {
	if (!o.tunnel_dns && o.mode != 'dns') return null;
	let out = '# сгенерировано vless-tunnel _dns-up, не править\n';
	let up = '127.0.0.1#' + o.dns_port;
	for (let d in o.domains) {
		if (!is_dns_name(d)) continue;
		if (o.tunnel_dns) out += 'server=/' + d + '/' + up + '\n';
		// Обе семьи — ОДНОЙ директивой nftset= на домен: две отдельные для
		// одного домена не складываются, dnsmasq молча запоминает только
		// первую (проверено на стенде — vless6_dns оставался пустым).
		if (o.mode == 'dns')
			out += 'nftset=/' + d + '/4#inet#fw4#vless4_dns,6#inet#fw4#vless6_dns\n';
	}
	if (o.tunnel_dns) {
		// '#' — «обычные серверы»: более точное совпадение побеждает, так
		// исключение из direct-domains остаётся на DNS провайдера, даже если
		// родительский домен есть в domains.
		if (o.mode != 'dns')
			for (let d in o.direct_domains)
				if (is_dns_name(d)) out += 'server=/' + d + '/#\n';
		// Домен самого сервера — только мимо туннеля: Xray резолвит его через
		// тот же dnsmasq, и без этой строки поиск адреса сервера ушёл бы в
		// туннель к этому же серверу.
		if (p && !p.host_is_ip && is_dns_name(p.host))
			out += 'server=/' + p.host + '/#\n';
	}
	return out;
}

// Перезапуск, а не reload: SIGHUP не перечитывает server=/nftset= из
// conf-dir. Если dnsmasq после этого не поднялся — убираем свой файл и
// поднимаем его заново: без dnsmasq у LAN нет ни DNS, ни DHCP.
function dnsmasq_restart(path) {
	run_capture('/etc/init.d/dnsmasq restart');
	for (let i = 0; i < 5; i++) {
		if (run_capture('pidof dnsmasq').code == 0) return true;
		system('sleep 1');
	}
	if (path && fs.access(path)) {
		fs.unlink(path);
		run_capture('/etc/init.d/dnsmasq restart');
	}
	warn('предупреждение: dnsmasq не поднялся с ' + (path ?? 'новой конфигурацией') +
		' — файл убран, dnsmasq перезапущен без него\n');
	return false;
}

function cmd_dns_up() {
	let cfg = cfg_get_all();
	let o = default_opts();
	let p = null;
	try { if (cfg.link) p = parse_link(cfg.link); } catch (e) { }

	let dir = dnsmasq_confdir();
	if (!dir) {
		warn('предупреждение: conf-dir dnsmasq не найден — DNS доменов из списка идёт как обычно\n');
		return;
	}
	let path = dir + '/' + DNSMASQ_FILE;
	let changed = false;
	if (path != DNSMASQ_LEGACY && fs.access(DNSMASQ_LEGACY)) {
		fs.unlink(DNSMASQ_LEGACY);
		changed = true;
	}

	let text = dnsmasq_text(p, o);
	if (text == null) {
		if (fs.access(path)) { fs.unlink(path); changed = true; }
	} else if (read_file(path) != text) {
		let tmp = '/tmp/vless-tunnel-dnsmasq.conf';
		write_file(tmp, text);
		let t = run_capture('dnsmasq --test -C ' + tmp);
		fs.unlink(tmp);
		if (t.code != 0) {
			warn('предупреждение: dnsmasq отверг сгенерированный ' + DNSMASQ_FILE +
				' — оставляю прежний:\n' + t.output);
		} else {
			ensure_dir(dir);
			write_file(path, text);
			changed = true;
		}
	}
	if (changed) dnsmasq_restart(path);
}

function cmd_dns_down() {
	let dir = dnsmasq_confdir();
	let changed = false;
	for (let path in [dir ? dir + '/' + DNSMASQ_FILE : null, DNSMASQ_LEGACY])
		if (path && fs.access(path)) { fs.unlink(path); changed = true; }
	if (changed) dnsmasq_restart(null);
}

// --- nftables: шаблон под режим, применение одной транзакцией ------------
// whitelist/proxy и dns отличаются набором сетов и цепочек (см. оба
// шаблона), поэтому при смене «семейства» режима nft-файл пересобирается.
// destroy + объявление заново — одним `nft -f`: либо применится всё, либо
// ничего, и при ошибке живой ruleset остаётся прежним. Ручной bypass не
// трогаем — его элементы добавляют руками, и они переживают смену режима.
const NFT_OWN_SETS = ['vless4', 'vless4_dns', 'vless6', 'vless6_dns', 'vless4_server', 'vless6_server'];

function cmd_apply_nft() {
	let cfg = cfg_get_all();
	let dns = cfg.mode == 'dns';
	let tpl = read_file(dns ? NFT_TEMPLATE_DNS : NFT_TEMPLATE);
	if (!tpl) fail('нет шаблона nft-правил в ' + SHARE_DIR + ' — переустановите (sh install.sh)');
	let port = int(cfg.tproxy_port);
	if (!match(cfg.lan, /^[A-Za-z0-9._-]+$/) || hex_to_int(cfg.fwmark) == null || port < 1 || port > 65535)
		fail('lan/fwmark/tproxy_port в /etc/config/' + UCI_CONF + ' некорректны');
	let body = replace(replace(replace(tpl, '__LAN_IFACE__', cfg.lan),
		'__FWMARK__', cfg.fwmark), '__TPROXY_PORT__', '' + port);

	let script = 'destroy chain inet fw4 vless_prerouting\ndestroy chain inet fw4 vless_prerouting6\n';
	for (let s in NFT_OWN_SETS) script += 'destroy set inet fw4 ' + s + '\n';
	script += 'table inet fw4 {\n' + body + '\n}\n';
	// Адреса сервера (sniffing-режимы) — сразу, не дожидаясь _build-config.
	let server = dns ? null : read_file(SERVER_NFT_FILE);
	if (server) script += 'table inet fw4 {\n' + server + '\n}\n';

	let tmp = '/tmp/vless-tunnel-apply.nft';
	write_file(tmp, script);
	let chk = run_capture('nft -c -f ' + tmp);
	if (chk.code != 0) {
		fs.unlink(tmp);
		fail('nft-правила не прошли проверку, ничего не менял:\n' + chk.output);
	}
	let r = run_capture('nft -f ' + tmp);
	fs.unlink(tmp);
	if (r.code != 0) fail('не удалось применить nft-правила:\n' + r.output);

	write_file(NFT_FILE, body);
	// В режиме dns обход сервера не нужен: в TPROXY идут только адреса из сетов.
	if (dns && fs.access(SERVER_NFT_FILE)) fs.unlink(SERVER_NFT_FILE);
	print('nft-правила (' + (dns ? 'dns' : 'sniffing') + ') применены\n');
}

// --- жив ли сервер по мнению observatory (fallback=1) --------------------
// null — неизвестно: Xray не запущен, fallback выключен или первая проба
// ещё не закончилась.
function tunnel_state() {
	let r = run_capture('wget -q -T 3 -O- http://' + METRICS_ADDR + '/debug/vars');
	if (r.code != 0) return null;
	let j = null;
	try { j = json(r.output); } catch (e) { return null; }
	let s = (type(j) == 'object' && type(j.observatory) == 'object') ? j.observatory.proxy : null;
	if (type(s) != 'object') return null;
	return { alive: s.alive == true, delay: s.delay, error: s.last_error_reason };
}

// --- тестовый (нетуннельный) конфиг для `test` --------------------------
// dokodemo-door с фиксированным адресом вместо tproxy: любое TCP-соединение
// на TEST_PORT прозрачно форвардится на TEST_TARGET:80 через настоящий
// outbound. Не нужен ни nftables, ни перехват LAN-трафика — только сама
// связь с сервером. Сознательно не HTTP-proxy inbound: локальный
// uclient-fetch (wget) на OpenWrt через http_proxy для доменных целей
// падает с "Operation not permitted" и путает относительные редиректы —
// с фиксированным форвардом wget просто стучится в 127.0.0.1 напрямую.
function build_test_config(p) {
	let flow = effective_flow(p);
	let user = { id: p.uuid, encryption: p.encryption || 'none' };
	if (flow) user.flow = flow;
	return {
		log: { loglevel: 'warning' },
		inbounds: [{
			tag: 'test-in', listen: '127.0.0.1', port: TEST_PORT,
			protocol: 'dokodemo-door',
			settings: { address: TEST_TARGET, port: 80, network: 'tcp' },
		}],
		outbounds: [{
			tag: 'proxy', protocol: 'vless',
			settings: { vnext: [{ address: p.host, port: p.port, users: [user] }] },
			streamSettings: build_stream(p),
			mux: { enabled: false },
		}],
	};
}

