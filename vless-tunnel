	}
}

function cmd_on() {
	if (!fs.access(CONFIG_JSON))
		fail('нет конфигурации — сначала vless-tunnel set-link "vless://..."');
	cfg_set({ enabled: '1' });
	let r = run_capture(INIT_SCRIPT + ' start');
	if (r.output) print(r.output);
	if (r.code != 0) fail('служба не запустилась (код ' + r.code + ')');
	print('vless-tunnel включён.\n');
}

function cmd_off() {
	cfg_set({ enabled: '0' });
	let r = run_capture(INIT_SCRIPT + ' stop');
	if (r.output) print(r.output);
	print('vless-tunnel выключен.\n');
}

function cmd_status() {
	let cfg = cfg_get_all();
	print('enabled: ' + (cfg.enabled == '1' ? 'да' : 'нет') + '\n');

	if (cfg.link) {
		try {
			print(summary(parse_link(cfg.link)));
		} catch (e) {
			print('ссылка сохранена, но не разбирается: ' + e.message + '\n');
		}
	} else {
		print('ссылка не задана\n');
	}

	print('служба: ' + (service_running() ? 'работает' : 'остановлена') + '\n');

	// После перестановки tproxy/meta mark set (см. .nft) падение Xray при
	// enabled=1 больше не кладёт весь LAN (fail-open вместо чёрной дыры) —
	// но это значит, что трафик из списков молча идёт мимо туннеля, пока
	// никто не заметил. doctor это ловит, но его надо специально
	// запустить — здесь то же самое видно сразу, без лишнего шага.
	if (cfg.enabled == '1' && service_running()) {
		let listening = run_capture('netstat -ln 2>/dev/null | grep -q ":' + cfg.tproxy_port + ' "');
		if (listening.code != 0)
			print('ВНИМАНИЕ: служба помечена работающей, но Xray не слушает tproxy_port ' +
				cfg.tproxy_port + ' — перехваченный трафик идёт мимо туннеля напрямую\n');
	}

	let rule = run_capture('ip rule list');
	let routed = index(rule.output, 'fwmark ' + cfg.fwmark) >= 0;
	print('policy routing (' + cfg.fwmark + '/' + cfg.table + '): ' +
		(routed ? 'активен' : 'не активен') + '\n');

	let chain = run_capture('nft list chain inet fw4 vless_prerouting');
	if (chain.code != 0) {
		print('перехват: правила fw4 не загружены (' + NFT_FILE + ')\n');
	} else {
		print('перехват (счётчики):\n');
		for (let line in split(chain.output, '\n'))
			if (index(line, 'counter') >= 0) print('  ' + trim(line) + '\n');
	}

	let o = default_opts();
	print('режим: ' + mode_title(o.mode) + '\n');
	print('в туннель по домену: ' + length(o.domains) + ', по IP: ' + length(o.subnets) +
		(o.mode == 'dns' ? '' : ', всегда напрямую: ' + length(o.direct_domains)) + '\n');
	if (o.mode == 'proxy' && !o.geoip_ok)
		print('ВНИМАНИЕ: mode=proxy, но нет ' + o.geoip +
			' — правило geoip:ru не добавлено, RU-адреса пойдут в туннель; vless-tunnel update-geo\n');
	print('DNS доменов из списка: ' + (o.tunnel_dns
		? 'через туннель (' + o.dns_upstream + ' с сервера)' : 'как обычно, через DNS роутера') + '\n');

	// Строка «туннель:» — её же показывает веб-страница.
	if (!o.fallback) {
		print('туннель: без fallback (сервер недоступен → туннельный трафик не идёт)\n');
	} else if (cfg.enabled == '1' && service_running()) {
		let st = tunnel_state();
		if (!st)
			print('туннель: состояние пока неизвестно (первая проверка сервера идёт)\n');
		else if (st.alive)
			print('туннель: сервер доступен (' + st.delay + ' мс)\n');
		else
			print('туннель: СЕРВЕР НЕДОСТУПЕН — туннельный трафик идёт напрямую (fallback)\n');
	}
}

// Проверка связи с сервером в обход nftables/TPROXY: временный http-
// inbound на TEST_PORT, реальный proxy-outbound из сохранённой ссылки.
function cmd_test() {
	let cfg = cfg_get_all();
	if (!cfg.link) fail('ссылка не задана — vless-tunnel set-link "vless://..."');
	let p = parse_link(cfg.link);

	let tmp = '/tmp/vless-tunnel-test.json';
	let log = '/tmp/vless-tunnel-test.log';
	write_file(tmp, sprintf('%.J\n', build_test_config(p)));

	let check = run_capture(XRAY_ENV + XRAY_BIN + ' run -test -c ' + tmp);
	if (check.code != 0) {
		fs.unlink(tmp);
		fail('Xray отверг тестовую конфигурацию:\n' + check.output);
	}

	let pid = run_background(XRAY_ENV + XRAY_BIN + ' run -c ' + tmp, log);
	let ready = false;
	for (let i = 0; i < 10; i++) {
		if (port_listening(TEST_PORT)) { ready = true; break; }
		system('sleep 1');
	}

	if (!ready) {
		system('kill ' + pid + ' 2>/dev/null');
		fs.unlink(tmp);
		fail('Xray не поднял тестовый порт за 10с, см. ' + log);
	}

	let r = run_capture('wget -T 8 -O- http://127.0.0.1:' + TEST_PORT + '/');
	system('kill ' + pid + ' 2>/dev/null');
	fs.unlink(tmp);

	if (r.code != 0) fail('сервер недоступен через туннель:\n' + r.output);
	print('OK: ' + p.host + ':' + p.port + ' (' + p.network + '/' + p.security +
		') отвечает через туннель\n');
}

function check(label, ok, detail) {
	print((ok ? '[OK]   ' : '[FAIL] ') + label + (detail ? ' — ' + detail : '') + '\n');
	return ok;
}

function cmd_doctor() {
	let ok = true;

	ok = check('xray-core установлен (' + XRAY_BIN + ')', !!fs.access(XRAY_BIN)) && ok;

	let chain = run_capture('nft list chain inet fw4 vless_prerouting');
	ok = check('nft-правила загружены в fw4', chain.code == 0,
		chain.code == 0 ? null : 'проверьте ' + NFT_FILE + ' и fw4 check') && ok;

	let mod = run_capture('grep -q nft_tproxy /proc/modules');
	ok = check('модуль ядра nft_tproxy загружен', mod.code == 0,
		mod.code == 0 ? null : 'apk add kmod-nft-tproxy kmod-nf-tproxy') && ok;

	let cfg = cfg_get_all();
	let o = default_opts();
	ok = check('режим: ' + mode_title(o.mode), cfg.mode in MODES,
		(cfg.mode in MODES) ? null : 'неизвестный mode=' + cfg.mode + ' — vless-tunnel mode whitelist|proxy|dns') && ok;

	// В режиме dns домены тегирует dnsmasq через nftset= — без dnsmasq-full
	// список молча не работает. А nft-файл должен быть от того же режима.
	if (o.mode == 'dns')
		ok = check('dnsmasq собран с поддержкой nftset (dnsmasq-full)', dnsmasq_has_nftset(),
			dnsmasq_has_nftset() ? null : 'переустановите: sh install.sh dns') && ok;
	if (chain.code == 0) {
		let dns_chain = index(chain.output, '@vless4_dns') >= 0;
		let same = dns_chain == (o.mode == 'dns');
		ok = check('nft-правила от текущего режима', same,
			same ? null : 'vless-tunnel _apply-nft && /etc/init.d/vless-tunnel restart') && ok;
	}

	// flow offload уводит установленные потоки мимо netfilter/TPROXY:
	// часть соединений уходит напрямую (с российским IP), хотя должна
	// быть в туннеле. Именно так «на компьютере работает, а приложение
	// на телефоне говорит, что страна не поддерживается».
	let off_sw = trim(run_capture('uci -q get firewall.@defaults[0].flow_offloading').output ?? '');
	let off_hw = trim(run_capture('uci -q get firewall.@defaults[0].flow_offloading_hw').output ?? '');
	let offload = off_sw == '1' || off_hw == '1';
	ok = check('flow offloading выключен (TPROXY с ним несовместим)', !offload,
		offload ? 'uci set firewall.@defaults[0].flow_offloading=0; uci set firewall.@defaults[0].flow_offloading_hw=0; uci commit firewall; fw4 reload' : null) && ok;

	// Если https-dns-proxy удалили, а в dnsmasq остался server=127.0.0.1#5053
	// (или #5054) — резолв уходит в мёртвый порт: интернет «моргает»
	// или не работает вовсе, а виноват не туннель. Проверяем именно
	// связку «пакета нет, а форвард остался».
	let doh_installed = run_capture('apk info -e https-dns-proxy >/dev/null 2>&1').code == 0;
	let stale_doh = run_capture('uci -q show dhcp | grep -E "127\\.0\\.0\\.1#505[34]"').output;
	if (!doh_installed && length(stale_doh))
		ok = check('dnsmasq не смотрит в мёртвый DoH-порт', false,
			'uci del_list dhcp.@dnsmasq[0].server=127.0.0.1#5053 (и #5054), uci commit dhcp, /etc/init.d/dnsmasq restart') && ok;
	else
		check('dnsmasq не смотрит в мёртвый DoH-порт', true);

	// nft-файл собирается из UCI при установке и смене режима (_apply-nft) —
	// если fwmark/tproxy_port поменяли в UCI руками, здесь это разойдётся
	// молча, кроме как в этой проверке.
	if (chain.code == 0) {
		let mark_m = match(chain.output, /mark set (0x[0-9a-fA-F]+)/);
		let port_m = match(chain.output, /tproxy ip6? to :([0-9]+)/);
		let synced = mark_m && port_m &&
			hex_to_int(mark_m[1]) == hex_to_int(cfg.fwmark) &&
			int(port_m[1]) == int(cfg.tproxy_port);
		ok = check('nft-правила совпадают с fwmark/tproxy_port из UCI', synced,
			synced ? null : 'значения разошлись — vless-tunnel _apply-nft && /etc/init.d/vless-tunnel restart') && ok;
	}

	ok = check('ссылка сервера задана', cfg.link != '') && ok;
	let p = null;
	if (cfg.link) {
		try {
			p = parse_link(cfg.link);
			check('ссылка разбирается корректно', true);
		} catch (e) {
			check('ссылка разбирается корректно', false, e.message);
			ok = false;
		}
	}

	// Без этого клиенты LAN с той же ссылкой (десктопный VLESS, VPN на
	// телефоне) заворачиваются в туннель роутера и не работают вовсе. В
	// режиме dns в TPROXY идут только адреса из сетов — обход не нужен.
	if (p && chain.code == 0 && o.mode != 'dns') {
		let ips = server_ips(p);
		let sets = run_capture('nft list set inet fw4 vless4_server; nft list set inet fw4 vless6_server').output;
		let elems = map(match(sets, /[0-9A-Fa-f]*[.:][0-9A-Fa-f.:]+/g) ?? [], (m) => m[0]);
		let missing = filter(ips, (a) => !(a in elems));
		let in_set = length(ips) && !length(missing);
		ok = check('сервер ' + p.host + ' идёт мимо Xray (vless4_server/vless6_server)', in_set,
			in_set ? null : !length(ips) ? 'адрес сервера не резолвится' :
				'нет ' + join(', ', missing) + ' — /etc/init.d/vless-tunnel restart' +
				(fs.access(SERVER_NFT_FILE) ? '' : '; если не поможет — переустановите (sh install.sh)')) && ok;
	}

	if (o.mode == 'proxy') {
		let geo = !!fs.access(cfg.geoip);
		ok = check('geoip.dat на месте (' + cfg.geoip + ')', geo,
			geo ? null : 'vless-tunnel update-geo') && ok;
	}

	check('доменов в списке: ' + length(o.domains) + ', IP-подсетей: ' + length(o.subnets) +
		(o.mode == 'dns' ? '' : ', всегда напрямую: ' + length(o.direct_domains)), true);

	if (fs.access(CONFIG_JSON) && fs.access(XRAY_BIN)) {
		let r = run_capture(XRAY_ENV + XRAY_BIN + ' run -test -c ' + CONFIG_JSON);
		ok = check('текущий config.json проходит проверку ядром', r.code == 0,
			r.code == 0 ? null : r.output) && ok;
	}

	if (service_running()) {
		let listening = run_capture('netstat -ln 2>/dev/null | grep -q ":' + cfg.tproxy_port + ' "');
		ok = check('служба работает — Xray слушает tproxy_port ' + cfg.tproxy_port, listening.code == 0,
			listening.code == 0 ? null : 'порт не занят — Xray мог не подняться, см. logread') && ok;

		// route_up() в init-скрипте заводит четыре объекта ядра разом (v4 и
		// v6 rule+route) — ничто не мешает части пропасть без остальных
		// (например, руками почищенный `ip route flush table`). Проект
		// везде зеркалит v6 отдельным набором правил — доктор тоже должен.
		let restart_hint = '/etc/init.d/vless-tunnel restart';

		let rule4 = run_capture('ip rule list').output;
		let has_rule4 = has_fwmark_rule(rule4, cfg.fwmark, cfg.table);
		ok = check('ip rule (v4) с fwmark ' + cfg.fwmark + ' на table ' + cfg.table + ' поднят',
			has_rule4, has_rule4 ? null : restart_hint) && ok;

		let rule6 = run_capture('ip -6 rule list').output;
		let has_rule6 = has_fwmark_rule(rule6, cfg.fwmark, cfg.table);
		ok = check('ip -6 rule с fwmark ' + cfg.fwmark + ' на table ' + cfg.table + ' поднят',
			has_rule6, has_rule6 ? null : restart_hint) && ok;

		// `ip route`/`ip -6 route` печатают 0.0.0.0/0 и ::/0 одинаково как
		// "default" в человекочитаемом выводе, не буквальным адресом.
		let has_route4 = index(run_capture('ip route list table ' + cfg.table).output, 'local default') >= 0;
		ok = check('local-маршрут (v4) в table ' + cfg.table + ' на месте',
			has_route4, has_route4 ? null : restart_hint) && ok;

		let has_route6 = index(run_capture('ip -6 route list table ' + cfg.table).output, 'local default') >= 0;
		ok = check('local-маршрут (v6) в table ' + cfg.table + ' на месте',
			has_route6, has_route6 ? null : restart_hint) && ok;

		// DNS доменов из списка: файл на месте, и домен из списка через
		// dnsmasq резолвится не в заглушку провайдера (127.0.0.1, 0.0.0.0).
		if (o.tunnel_dns || o.mode == 'dns') {
			let dir = dnsmasq_confdir();
			let has_file = dir && fs.access(dir + '/' + DNSMASQ_FILE);
			ok = check('dnsmasq получил ' + DNSMASQ_FILE + ' (' + (dir ?? 'conf-dir не найден') + ')',
				!!has_file, has_file ? null : restart_hint) && ok;
		}
		let probe = null;
		for (let d in o.domains)
			if (is_dns_name(d)) { probe = d; break; }
		if (o.tunnel_dns && probe) {
			let r = run_capture('nslookup -type=a ' + probe + ' 127.0.0.1');
			let addrs = [], answer = false;
			for (let line in split(r.output, '\n')) {
				if (match(line, /^Name:/)) answer = true;
				let m = answer ? match(line, /^Address:[ \t]*([0-9.]+)/) : null;
				if (m) push(addrs, m[1]);
			}
			let good = length(addrs) && !length(filter(addrs, (a) => match(a, /^(127\.|0\.)/)));
			ok = check('DNS через туннель: ' + probe + ' → ' + (length(addrs) ? join(' ', addrs) : 'нет ответа'),
				good, good ? null : 'нет ответа или заглушка; напрямую через Xray: nslookup ' + probe +
					' 127.0.0.1:' + o.dns_port) && ok;
		}

		if (o.fallback) {
			let st = tunnel_state();
			if (st && !st.alive)
				ok = check('сервер доступен через туннель', false,
					'нет — туннельный трафик идёт напрямую (fallback); ' + (st.error ?? '')) && ok;
			else
				check('сервер доступен через туннель', true,
					st ? st.delay + ' мс' : 'первая проверка ещё идёт');
		}
	}

	print(ok ? '\nвсё в порядке.\n' : '\nесть проблемы, см. выше.\n');
	if (!ok) exit(1);
}

// --- управление списком доменов -----------------------------------------
// Отдельно от setup/set-link: домены меняются заметно чаще, чем ссылка
// сервера, и не должны требовать пересборки/проверки всего конфига с нуля
// каждый раз через CLI-аргумент — отсюда точечные add/remove поверх уже
// существующего файла, плюс bulk-замена для веб-страницы (правит весь файл
// сразу, включая комментарии-заголовки категорий).

function domains_path() {
	return cfg_get_all().domains;
}

// Не полноценная RFC-валидация домена — только защита от явного мусора
// (пустая строка, пробелы, случайно вставленный комментарий).
function is_valid_domain_line(d) {
	return d != '' && index(d, '#') < 0 && !match(d, / /) && index(d, '.') > 0;
}

// Пересобирает config.json из актуальных domains/subnets и перезапускает
// службу, если она уже работает — тот же принцип, что у set-link: правки
// применяются сразу, а не только на следующий ручной restart.
function apply_lists_change() {
	if (!fs.access(CONFIG_JSON)) return;
	let r = run_capture(SELF_BIN + ' _build-config');
	if (r.code != 0) { warn('ошибка пересборки config.json:\n' + r.output + '\n'); return; }
	if (service_running()) run_capture(INIT_SCRIPT + ' restart');
}

function cmd_domains() {
	for (let d in read_list(domains_path())) print(d + '\n');
}

function add_domain_to(path, d) {
	d = lc(trim(d ?? ''));
	if (!is_valid_domain_line(d)) fail('некорректный домен: ' + d);
	ensure_dir(CONFIG_DIR);
	ensure_list_file(path, '');
	for (let e in read_list(path))
		if (e == d) { print('уже в списке: ' + d + '\n'); return; }
	let f = fs.open(path, 'a');
	if (!f) fail('не удалось открыть на запись: ' + path);
	f.write(d + '\n');
	f.close();
	print('добавлено: ' + d + '\n');
	apply_lists_change();
}

// Удаляет только строку с самим доменом (после отсечения комментария) —
// остальные строки файла, включая заголовки категорий и пустые строки,
// остаются как есть.
function remove_domain_from(path, d) {
	d = lc(trim(d ?? ''));
	let text = read_file(path) ?? '';
	let kept = [];
	let found = false;
	for (let line in split(text, '\n')) {
		let bare = lc(trim(replace(line, /#.*/, '')));
		if (bare == d) { found = true; continue; }
		push(kept, line);
	}
	if (!found) fail('не найдено в списке: ' + d);
	write_file(path, join('\n', kept));
	print('удалено: ' + d + '\n');
	apply_lists_change();
}

function cmd_add_domain(d) {
	add_domain_to(domains_path(), d);
}

function cmd_remove_domain(d) {
	remove_domain_from(domains_path(), d);
}

function direct_domains_path() {
	return cfg_get_all().direct_domains;
}

function cmd_direct_domains() {
	for (let d in read_list(direct_domains_path())) print(d + '\n');
}

function cmd_add_direct(d) {
	add_domain_to(direct_domains_path(), d);
}

function cmd_remove_direct(d) {
	remove_domain_from(direct_domains_path(), d);
}

// Внутренняя: замена всего файла целиком (для веб-страницы — там
// редактируется общий textarea, а не одна запись).
function cmd_set_domains_file(tmp_path) {
	let text = read_file(tmp_path);
	if (text == null) fail('не удалось прочитать ' + tmp_path);
	ensure_dir(CONFIG_DIR);
	write_file(domains_path(), text);
	apply_lists_change();
}

function cmd_set_direct_file(tmp_path) {
	let text = read_file(tmp_path);
	if (text == null) fail('не удалось прочитать ' + tmp_path);
	ensure_dir(CONFIG_DIR);
	write_file(direct_domains_path(), text);
	apply_lists_change();
}

// whitelist ↔ proxy — только пересборка config.json. Переход в dns или из
// него меняет и nft-правила (другие сеты и цепочки, см. cmd_apply_nft), а
// для dns ещё нужен dnsmasq-full — его ставит только install.sh dns:
// замена dnsmasq на лету — ровно та операция, что однажды оставила роутер
// без DNS и DHCP.
function cmd_mode(arg) {
	let cfg = cfg_get_all();
	if (!arg) {
		print('режим: ' + mode_title(cfg.mode) + '\n');
		return;
	}
	arg = lc(trim(arg));
	if (!(arg in MODES))
		fail('режим должен быть whitelist, proxy или dns');
	if (arg == 'dns' && !dnsmasq_has_nftset())
		fail('для режима dns нужен dnsmasq-full — переустановите: sh install.sh dns');
	let family_changed = (cfg.mode == 'dns') != (arg == 'dns');
	cfg_set({ mode: arg });
	print('режим: ' + arg + '\n');
	if (family_changed) cmd_apply_nft();
	apply_lists_change();
	if (arg == 'proxy' && !fs.access(cfg.geoip))
		print('geoip.dat ещё нет — выполните vless-tunnel update-geo, иначе RU-адреса пойдут в туннель\n');
}

// geoip.dat нужен только режиму proxy — там по нему RU-адреса исключаются
// из туннеля. Файл статический (снимок GeoIP на момент скачивания), поэтому
// это отдельная команда, а не подписка и не часть каждой установки.
function cmd_update_geo() {
	let cfg = cfg_get_all();
	let tmp = '/tmp/vless-tunnel-geoip.dat';
	ensure_dir(CONFIG_DIR);
	print('скачиваю ' + GEOIP_URL + '\n');
	let r = run_capture('wget -q -T 60 -O ' + tmp + ' "' + GEOIP_URL + '"');
	if (r.code != 0) fail('не удалось скачать geoip.dat:\n' + r.output);
	let sz = int(trim(run_capture('wc -c < ' + tmp).output));
	if (sz < 1000000) {
		fs.unlink(tmp);
		fail('скачанный geoip.dat слишком мал (' + sz + ' байт) — не заменяю');
	}

	let backup = cfg.geoip + '.bak';
	if (fs.access(cfg.geoip)) system('cp -f ' + cfg.geoip + ' ' + backup);
	system('cp -f ' + tmp + ' ' + cfg.geoip);
	system('chmod 0644 ' + cfg.geoip);
	fs.unlink(tmp);
	print('файл скачан (' + sz + ' байт), проверяю...\n');

	// `xray -test` не грузит geo-данные, поэтому проверяем по-настоящему:
	// после замены служба должна подняться и слушать tproxy_port. Если
	// нет (битый/чужой файл) — возвращаем предыдущий и поднимаемся с ним.
	if (service_running()) {
		run_capture(INIT_SCRIPT + ' restart');
		let up = false;
		for (let i = 0; i < 10; i++) {
			if (port_listening(int(cfg.tproxy_port))) { up = true; break; }
			system('sleep 1');
		}
		if (!up) {
			if (fs.access(backup)) {
				system('cp -f ' + backup + ' ' + cfg.geoip);
			} else {
				// Бэкапа не было (первое обновление) — возвращаемся к
				// состоянию «geoip нет», а не оставляем заведомо битый файл.
				fs.unlink(cfg.geoip);
			}
			run_capture(INIT_SCRIPT + ' restart');
			fail('ядро не поднялось с новым geoip.dat — предыдущее состояние восстановлено');
		}
	}
	print('geoip.dat обновлён\n');
}

// Полное удаление: служба, правила, DNS-файл dnsmasq, конфигурация, списки,
// веб-страница и сам CLI. Снимает только то, что сами же добавили в живой
// ruleset — через nft destroy, а не через fw4 reload: на роутере рядом
// вполне может стоять другой сервис со своими nft-правилами мимо
// /etc/nftables.d (см. HANDOFF.md), и полный reload их бы снёс.
//
// flow offloading возвращается в то состояние, что было до установки
// (install.sh запоминает его в UCI). dnsmasq-full (режим dns) остаётся: он
// работает как обычный dnsmasq, а обратная замена — та же опасная операция,
// что и прямая. --purge дополнительно удаляет пакет xray-core.
function cmd_uninstall(arg) {
	let purge = arg == '--purge';
	if (arg && !purge) fail('неизвестный аргумент: ' + arg + ' (ожидается --purge)');
	// saved_offload_* пишет только install.sh, в cfg_defaults их нет
	let saved = {};
	try { saved = uci.cursor().get_all(UCI_CONF, 'main') ?? {}; } catch (e) { }

	if (fs.access(INIT_SCRIPT)) {
		run_capture(INIT_SCRIPT + ' stop');
		run_capture(INIT_SCRIPT + ' disable');
	}
	// stop уже убрал DNS-файл, если служба работала; если нет — убираем здесь.
	cmd_dns_down();

	let script = 'destroy chain inet fw4 vless_prerouting\ndestroy chain inet fw4 vless_prerouting6\n';
	for (let s in NFT_OWN_SETS)
		script += 'destroy set inet fw4 ' + s + '\n';
	script += 'destroy set inet fw4 vless4_bypass\ndestroy set inet fw4 vless6_bypass\n';
	let tmp = '/tmp/vless-tunnel-uninstall.nft';
	write_file(tmp, script);
	let r = run_capture('nft -f ' + tmp);
	fs.unlink(tmp);
	if (r.code != 0) warn('предупреждение: nft-правила сняты не полностью:\n' + r.output);
	fs.unlink(NFT_FILE);
	fs.unlink(SERVER_NFT_FILE);

	if (saved.saved_offload_sw == '1' || saved.saved_offload_hw == '1') {
		system('uci -q set firewall.@defaults[0].flow_offloading=' + (saved.saved_offload_sw == '1' ? '1' : '0') +
			'; uci -q set firewall.@defaults[0].flow_offloading_hw=' + (saved.saved_offload_hw == '1' ? '1' : '0') +
			'; uci commit firewall; fw4 reload >/dev/null 2>&1');
		print('flow offloading включён обратно, как было до установки\n');
	}

	system('rm -rf ' + CONFIG_DIR + ' ' + SHARE_DIR);
	fs.unlink('/etc/config/' + UCI_CONF);
	fs.unlink(INIT_SCRIPT);
	fs.unlink('/www/cgi-bin/vless-tunnel');
	fs.unlink('/www/t.html');
	fs.unlink(SELF_BIN);

	if (purge) {
		let a = run_capture('apk del xray-core');
		print(a.code == 0 ? 'пакет xray-core удалён\n' : 'предупреждение: apk del xray-core: ' + a.output);
	}

	print('vless-tunnel удалён.\n');
	if (!purge)
		print('Пакет xray-core оставлен — удалить: apk del xray-core\n');
	if (dnsmasq_has_nftset())
		print('dnsmasq-full оставлен: он работает как обычный dnsmasq\n');
}

function usage_text() {
	return 'использование: vless-tunnel <команда> [аргументы]\n\n' +
		'  setup [ссылка]        подготовить рабочие файлы, опционально задать ссылку\n' +
		'  set-link <ссылка>     разобрать ссылку, проверить и сохранить конфигурацию\n' +
		'  on / off              включить / выключить туннель\n' +
		'  status                текущее состояние\n' +
		'  test                  проверить связь с сервером в обход nftables\n' +
		'  doctor                диагностика окружения\n' +
		'  domains               вывести текущий список доменов\n' +
		'  add-domain <домен>    добавить домен в список (в туннель)\n' +
		'  remove-domain <домен> убрать домен из списка (в туннель)\n' +
		'  direct-domains        домены, которые всегда напрямую\n' +
		'  add-direct <домен>    добавить домен в исключения (всегда напрямую)\n' +
		'  remove-direct <домен> убрать домен из исключений\n' +
		'  mode [whitelist|proxy|dns]  режим: whitelist — только domains/subnets,\n' +
		'                        proxy — весь веб в туннель кроме RU,\n' +
		'                        dns — domains/subnets, решение по DNS (нужен install.sh dns)\n' +
		'  update-geo            скачать/обновить geoip.dat (нужен для mode=proxy)\n' +
		'  uninstall [--purge]   удалить vless-tunnel целиком (--purge — и xray-core)\n' +
		'  help                  показать эту справку\n' +
		'  parse <ссылка>        разобрать ссылку и напечатать разбор (отладка)\n' +
		'  make <ссылка> <файл>  собрать config.json в указанный файл (отладка)\n';
}

function usage() {
	warn(usage_text());
	exit(2);
}

function cmd_help() {
	print(usage_text());
}

let args = ARGV;
if (!length(args)) usage();
let cmd = args[0];

try {
	if (cmd == 'parse') {
		if (length(args) < 2) usage();
		cmd_parse(args[1]);
	} else if (cmd == 'make') {
		if (length(args) < 3) usage();
		cmd_make(args[1], args[2]);
	} else if (cmd == 'setup') {
		cmd_setup(args[1]);
	} else if (cmd == 'set-link') {
		if (length(args) < 2) usage();
		cmd_set_link(args[1]);
	} else if (cmd == 'on') {
		cmd_on();
	} else if (cmd == 'off') {
		cmd_off();
	} else if (cmd == 'status') {
		cmd_status();
	} else if (cmd == 'test') {
		cmd_test();
	} else if (cmd == 'doctor') {
		cmd_doctor();
	} else if (cmd == 'uninstall') {
		cmd_uninstall(args[1]);
	} else if (cmd == '_build-config') {
		cmd_build_config();
	} else if (cmd == '_apply-nft') {
		cmd_apply_nft();
	} else if (cmd == '_dns-up') {
		cmd_dns_up();
	} else if (cmd == '_dns-down') {
		cmd_dns_down();
	} else if (cmd == 'domains') {
		cmd_domains();
	} else if (cmd == 'add-domain') {
		if (length(args) < 2) usage();
		cmd_add_domain(args[1]);
	} else if (cmd == 'remove-domain') {
		if (length(args) < 2) usage();
		cmd_remove_domain(args[1]);
	} else if (cmd == 'direct-domains') {
		cmd_direct_domains();
	} else if (cmd == 'add-direct') {
		if (length(args) < 2) usage();
		cmd_add_direct(args[1]);
	} else if (cmd == 'remove-direct') {
		if (length(args) < 2) usage();
		cmd_remove_direct(args[1]);
	} else if (cmd == 'mode') {
		cmd_mode(args[1]);
	} else if (cmd == 'update-geo') {
		cmd_update_geo();
	} else if (cmd == '_set-domains-file') {
		if (length(args) < 2) usage();
		cmd_set_domains_file(args[1]);
	} else if (cmd == '_set-direct-file') {
		if (length(args) < 2) usage();
		cmd_set_direct_file(args[1]);
	} else if (cmd == 'help' || cmd == '-h' || cmd == '--help') {
		cmd_help();
	} else {
		warn('неизвестная команда: ' + cmd + '\n');
		usage();
	}
} catch (e) {
	warn('ошибка: ' + e.message + '\n');
	exit(1);
}
